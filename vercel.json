{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mentor.avo42.com" }],
      "destination": "/mentor/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mentor.avo42.com" }],
      "destination": "/mentor/:path*"
    }
  ]
}
